# Force real 301 redirects for the readytoteok.com domain aliases
# (readytoteok.com is a Netlify domain alias on this same project,
# so it serves live content instead of redirecting unless told to here)
https://readytoteok.com/*      https://www.readytoteokc.com/:splat   301!
https://www.readytoteok.com/*  https://www.readytoteokc.com/:splat   301!

# Retired standalone booking page (book.html). The only booking form is now
# the one on the homepage (#book). Sends old links and search results there.
/book.html  /#book  301!
/book       /#book  301!

# Short confirm link in the confirm text: readytoteokc.com/c/CODE shows
# confirm.html (the address bar keeps the short link; the page reads CODE).
/c/*  /confirm.html  200

# Add Rental is now the "Log only, no email" mode of the Send Invoice form.
/admin-add-rental.html  /admin-invoice.html?mode=log  301!
/admin-add-rental       /admin-invoice.html?mode=log  301!

# Source code and internal notes aren't part of the website. Netlify publishes
# this whole folder, so without these rules anyone could download the server
# functions or the notes. (/.netlify/functions/*, with the dot, is how the
# functions are *called*, and isn't affected.)
/netlify/*            /404  404!
/IMPROVEMENT_PLAN.md  /404  404!
/package.json         /404  404!
/netlify.toml         /404  404!
/_redirects           /404  404!
